papers/

# ── LaTeX article (main/) ─────────────────────────────────────────────────────
# The article source IS versioned. Byproducts are listed by extension on purpose:
# a bare `main/` or `main/report/` rule excludes the directory, git never descends
# into an excluded directory, and every `!` rule below would become inert — the
# article would silently vanish from git again. Do not "simplify" this.
main/*.aux
main/*.bbl
main/*.blg
main/*.fdb_latexmk
main/*.fls
main/*.log
main/*.out
main/*.pdf
main/*.spl
main/*.synctex.gz
main/report/*.aux
main/report/*.bbl
main/report/*.blg
main/report/*.log
main/report/*.out
main/report/*.pdf

# Result figures embedded in the article ARE versioned.
# Must stay AFTER the blanket `*.png` above — last match wins.
!main/report/*.png
!main/figures/*.png

# ── WSL / tooling artefacts ───────────────────────────────────────────────────
*:Zone.Identifier
.atl/

# Kaggle API tokens — NUNCA versionar
.json/
*.json:Zone.Identifier

# CodeGraph runtime state (machine-local, changes every session)
.codegraph/daemon.pid

# pytest cache
.pytest_cache/

# LaTeX byproducts in figure subdirectories
main/figures/*.log
main/figures/*.aux

# Excel/LibreOffice lock files
~$*
.~lock.*
